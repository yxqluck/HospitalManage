{
  "name": "hospital-management-admin",
  "version": "1.0.0",
  "description": "医院管理系统前端：病房、病床、病人、医生、住院、治疗记录、统计报表",
  "author": "hospital",
  "private": false,
  "scripts": {
    "dev": "vite --mode env.local",
    "ts:check": "node --max_old_space_size=8192 ./node_modules/vue-tsc/bin/vue-tsc.js --noEmit --incremental --tsBuildInfoFile node_modules/.cache/vue-tsc/tsconfig.tsbuildinfo",
    "build:local": "node --max_old_space_size=8192 ./node_modules/vite/bin/vite.js build --mode env.local",
    "build:prod": "node --max_old_space_size=8192 ./node_modules/vite/bin/vite.js build --mode prod",
    "preview": "pnpm build:local && vite preview"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@vueuse/core": "14.4.0",
    "axios": "1.19.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.20",
    "element-plus": "catalog:",
    "jsencrypt": "^3.5.4",
    "lodash-es": "^4.18.1",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qs": "^6.15.1",
    "vue": "catalog:",
    "vue-dompurify-html": "^5.3.0",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0",
    "vue-types": "^6.0.0",
    "vue3-print-nb": "^0.1.4",
    "web-storage-cache": "^1.1.1"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.470",
    "@intlify/unplugin-vue-i18n": "11.2.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "24.19.2",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.15.0",
    "@unocss/transformer-variant-group": "66.7.5",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "rollup": "^4.60.3",
    "rollup-plugin-visualizer": "5.14.0",
    "sass": "^1.99.0",
    "typescript": "catalog:",
    "unocss": "66.7.5",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.0.0",
    "vite": "8.2.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-svg-icons-ng": "^1.9.0",
    "vue-tsc": "3.3.9"
  },
